<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.astraisland.permission.PUBLISH_ACTIVITY" />
    <uses-permission android:name="com.astraflow.tool.island.permission.PUBLISH_ACTIVITY" />
    <uses-permission android:name="com.astraflow.tool.debug.island.permission.PUBLISH_ACTIVITY" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="com.astraisland" />
        <package android:name="com.astraflow.tool" />
        <package android:name="com.astraflow.tool.debug" />
        <package android:name="com.larus.nova" />
    </queries>

    <application
        android:name=".BridgeApp"
        android:label="豆包岛桥"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- LSPosed module declaration -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="抓豆包(com.larus.nova)流式回复喂给星河岛 + 桥接保活" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Binder delivery endpoint. Broadcasts to a frozen cached app are
             DEFER_BY_OPLUS'd and never flushed on thaw; a Binder txn into the
             provider thawed us in ~1.1s. Exported so Doubao/system_server/root
             can reach it — EventProvider enforces a uid allowlist. -->
        <provider
            android:name=".EventProvider"
            android:authorities="com.islandbridge.events"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- keep-alive ping target (woken by LSPosed broadcasts) -->
        <receiver android:name=".KeepAliveReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.islandbridge.KEEPALIVE" />
                <action android:name="com.islandbridge.PING" />
            </intent-filter>
        </receiver>
        <!-- events captured inside the Doubao process by the module -->
        <receiver android:name=".BridgeEventReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.islandbridge.EVENT" />
                <action android:name="com.islandbridge.EVENT_PC" />
            </intent-filter>
        </receiver>
        <!-- island card blank-area tap (openIntent) -> open Doubao + end card -->
        <receiver android:name=".OpenDoubaoReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.islandbridge.OPEN_DOUBAO" />
            </intent-filter>
        </receiver>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
